# URL completa fornecida pelo provedor MySQL gerenciado
DATABASE_URL=mysql://usuario:senha@host:3306/nome_do_banco

# Usar apenas se o provedor exigir SSL
DB_SSL=false
# DB_SSL_CA=/caminho/para/ca.pem

XP_POR_NIVEL=100
APP_ENV=production

# SMTP para envio dos códigos de recuperação de senha
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=seu-usuario-smtp
MAIL_PASSWORD=sua-senha-smtp
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=Logic Gate
MAIL_ENCRYPTION=tls
